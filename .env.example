# ═══════════════════════════════════════════════════════
#  環境変数テンプレート
#  このファイルをコピーして .env を作成してください
#    cp .env.example .env
#  .env は Git にコミットしないこと（.gitignore 済み）
# ═══════════════════════════════════════════════════════

# ── Firebase 設定 ──────────────────────────────────────
# Firebase コンソール > プロジェクトの設定 > マイアプリ から取得
# ※ これらは「公開前提の識別子」であり秘密情報ではありません。
#   実際の保護は Firestore セキュリティルール・App Check・
#   APIキーの HTTP リファラ制限で行います。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Google Analytics (GA4) ─────────────────────────────
# 「G-」で始まる測定ID。未設定の場合は計測が無効になるだけで動作します
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── AIチャット（Firebase AI Logic） ─────────────────────
# Gemini のモデルID。モデルの世代交代に合わせて差し替えます
VITE_AI_MODEL=gemini-3.7-flash

# ── App Check（reCAPTCHA Enterprise） ──────────────────
# Firebase コンソール > App Check で登録して発行されるサイトキー。
# Firebase AI Logic は App Check が必須のため、本番では必ず設定します
VITE_RECAPTCHA_SITE_KEY=

# ローカル開発用のデバッグトークン（本番では空のまま）
VITE_APPCHECK_DEBUG_TOKEN=

# Firebase エミュレータに接続する場合は true
VITE_USE_EMULATOR=false

# ═══════════════════════════════════════════════════════
#  【重要】Gemini の APIキーはここに書かないこと
#  VITE_ 接頭辞の変数はビルド成果物に平文で埋め込まれ、
#  公開サイトから誰でも抽出できてしまいます。
#  AIチャットは Firebase AI Logic 経由で呼び出すため、
#  アプリ側に Gemini の APIキーを持つ必要はありません。
# ═══════════════════════════════════════════════════════
